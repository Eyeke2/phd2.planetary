[Icons]
Name: "{group}\PHD Guiding 2 (solar)"; FileName: "{app}\phd2.exe"; Parameters: "-i 2"
Name: "{commondesktop}\PHD Guiding 2 (solar)"; Filename: "{app}\phd2.exe"; Tasks: desktopicon; IconFilename: "{app}\phd2.exe"; IconIndex: 0; Parameters: "-i 2"

[Tasks]
Name: "desktopicon"; Description: "Create a &desktop icon"; GroupDescription: "Additional icons:";

[Run]
Filename: {tmp}\dark_mover.vbs; Description: Relocate dark files; Flags: shellexec waituntilterminated
Filename: {app}\phd2.exe; Parameters: "-i 2"; Description: Launch {#APP_NAME} after installation; Flags: nowait postinstall runasoriginaluser skipifsilent

[Registry]
Root: HKCU; Subkey: Software\StarkLabs; Flags: uninsdeletekeyifempty
Root: HKCU; Subkey: Software\StarkLabs\PHDGuidingV2; Flags: uninsdeletekey

[Code]

procedure CurStepChanged(CurStep: TSetupStep);
var
  ResultCode, i, N: Integer;
  Args, P: string;
begin
  if (CurStep = ssDone) and WizardSilent() then
  begin
    Args := '';
    for I := 1 to ParamCount do
    begin
      P := ParamStr(i);
      if Pos('/instance=', Lowercase(P)) = 1 then
        if (Length(P) > Length('/instance=')) then
        begin
          N := StrToIntDef(Copy(P, Length('/instance=') + 1, MaxInt), 0);
          if (N >= 1) and (N <= 16) then
            Args := '-i ' + IntToStr(N);
        end;
    end;

    for I := 1 to ParamCount do
      if CompareText(ParamStr(i), '/launch') = 0 then
      begin
        ExecAsOriginalUser(ExpandConstant('{app}\phd2.exe'), Args, '', SW_SHOWNORMAL, ewNoWait, ResultCode);
        break;
      end;
  end;
end;

procedure UpdateFirewallRules();
var
  ResultCode: Integer;
begin
  Exec('netsh.exe', 'advfirewall firewall delete rule name=' + AddQuotes(ExpandConstant('{#APP_NAME}')) + ' dir=in program=' + AddQuotes(ExpandConstant('{app}\phd2.exe')), '', SW_HIDE, ewWaitUntilTerminated, ResultCode);
  Exec('netsh.exe', 'advfirewall firewall add rule name=' + AddQuotes(ExpandConstant('{#APP_NAME}')) + ' dir=in action=allow program=' + AddQuotes(ExpandConstant('{app}\phd2.exe')) + ' profile=private', '', SW_HIDE, ewWaitUntilTerminated, ResultCode);
end;
